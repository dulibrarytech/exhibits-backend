<%- include('../partials/header.ejs'); %>
<body>
<%- include('../partials/nav-dashboard.ejs'); %>
<div id="right-panel" class="right-panel"> <%- include('../partials/main-header.ejs'); %>
    <main id="main" class="content" tabindex="-1">
        <div id="message"></div>
        <h1><span id="exhibit-title"></span> - Vertical Timeline</h1>
        <%- include('partials/item-vertical-timeline-data-card.ejs', { is_details: true }); %>
        <div id="item-submit-card" class="card">
            <div class="card-body">
                <button class="btn btn-primary" type="button" id="edit-item-btn"><i class="fa fa-edit" aria-hidden="true"></i>&nbsp;&nbsp;Edit
                </button>&nbsp;&nbsp;<span class="alert alert-warning"><i class="fa fa-warning" aria-hidden="true"></i> Changes made to published exhibit timelines are immediately visible to the public</span>
                <button class="btn btn-primary" type="button" id="save-timeline-btn" style="visibility: hidden"><i
                            class="fa fa-save" aria-hidden="true"></i>&nbsp;&nbsp;Save
                </button>
            </div>
            <div class="card-footer text-muted"><small>Vertical Timeline</small></div>
        </div>
    </main>
    <div class="clearfix"></div> <%- include('../partials/footer.ejs'); %>
</div><!-- libs --> <%- include('../partials/exhibits-libs-common.ejs'); %>
<!-- app --> <%- include('../partials/exhibits-app-common.ejs'); %>
<script src="/exhibits-dashboard/static/app/dist/exhibits.module.min.js?<%= build_version %>"></script>
<script src="/exhibits-dashboard/static/app/dist/items.module.min.js?<%= build_version %>"></script>
<script src="/exhibits-dashboard/static/app/dist/items.common.vertical.timeline.form.module.min.js?<%= build_version %>"></script>
<script src="/exhibits-dashboard/static/app/dist/items.details.vertical.timeline.module.min.js?<%= build_version %>"></script>
<script>
    navModule.init();
    navModule.wire_nav_links();
    itemsCommonVerticalTimelineFormModule.init();
    itemsDetailsVerticalTimelineModule.init();
    pageActionsModule.wire_edit_button({
        edit_path: '/items/vertical-timeline/edit',
        params: ['exhibit_id', 'item_id']
    });</script>
</body>
