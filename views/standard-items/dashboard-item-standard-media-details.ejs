<%- include('../partials/header.ejs'); %>
<body>
<%- include('../partials/nav-dashboard'); %>
<div id="right-panel" class="right-panel">
    <%- include('../partials/main-header.ejs'); %>
    <main id="main" class="content" tabindex="-1">
        <div id="message"></div>
        <h1><span id="exhibit-title"></span> - Media Item</h1>
        <%- include('../partials/item-media-card.ejs', { is_details: true, show_pdf_page: true, show_standard_fields: true }); %>

        <%- include('partials/item-data-card.ejs', { is_details: true }); %>
        <%- include('../grid-items/partials/item-layout-card.ejs', { default_layout: 'media_right' }); %>
        <div id="item-media-widths-card" class="card">
            <div class="card-header">
                <strong class="card-title mb-3">Item Media Widths</strong>
            </div>
            <div class="card-body">
                <%- include('partials/item-media-widths.ejs'); %>
            </div>
        </div>

        <input type="hidden" id="is-published" name="is_published">
        <div id="exhibit-submit-card" class="card">
            <div class="card-body">
                <button class="btn btn-primary" type="button" id="edit-item-btn">
                    <i class="fa fa-edit" aria-hidden="true"></i>&nbsp;&nbsp;Edit
                </button>&nbsp;&nbsp;<span class="alert alert-warning"><i class="fa fa-warning" aria-hidden="true"></i> Changes made to published exhibit items are immediately visible to the public</span>
            </div>
            <div class="card-footer text-muted"><small>Item</small></div>
        </div>
    </main>
    <div class="clearfix"></div>
    <%- include('../partials/footer.ejs'); %>
</div>
<!-- libs -->
<%- include('../partials/exhibits-libs-common.ejs'); %>
<!-- app -->
<%- include('../partials/exhibits-app-common.ejs'); %>
<script src="/exhibits-dashboard/static/app/dist/exhibits.module.min.js?<%=build_version%>"></script>
<script src="/exhibits-dashboard/static/app/dist/items.module.min.js?<%=build_version%>"></script>
<script src="/exhibits-dashboard/static/app/dist/items.common.standard.item.form.module.min.js?<%=build_version%>"></script>
<script src="/exhibits-dashboard/static/app/dist/items.details.standard.item.module.min.js?<%=build_version%>"></script>
<script>
    itemsCommonStandardItemFormModule.init();
    itemsDetailsStandardItemModule.init();
    navModule.wire_nav_links();
    pageActionsModule.wire_edit_button({
        edit_path: '/items/standard/media/edit',
        params: ['exhibit_id', 'item_id']
    });
</script>
</body>
</html>
