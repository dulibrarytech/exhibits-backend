<div class="row form-group">
    <div class="col-12">
        <label for="grid-columns" class="form-text text-muted" style="font-size: 17px">Grid Columns <span class="badge badge-required">Required</span>
        </label>
        <small id="grid-columns-hint" class="form-text text-muted"><i class="fa fa-exclamation-circle" aria-hidden="true"></i> <em>Select the number of columns to display (2&ndash;4).</em></small>
        <select id="grid-columns" name="grid_columns"
                class="form-control" required
                aria-describedby="grid-columns-hint">
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4" selected>4</option>
        </select>
    </div>
</div>
