<%- include('../partials/header.ejs'); %>
<body>
<%- include('../partials/nav-dashboard'); %>
<div id="right-panel" class="right-panel">
    <%- include('../partials/main-header.ejs'); %>
    <main id="main" class="content" tabindex="-1">
        <div id="message"></div>
        <h1><span id="exhibit-title"></span> - Grid</h1>
        <div id="grid-data-card" class="card">
            <div class="card-header">
                <strong class="card-title mb-3">Item Data</strong>
                <div class="btn-group float-right">
                    <span id="created" style="text-align: right; font-size: x-small"></span>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-8 col-md-8">
                        <div class="row form-group">
                            <div class="col-12">
                                <div class="form-text text-muted" style="font-size: 17px">Text

                                </div>
                                <div id="grid-text-input" class="rte-container" data-rte="full" data-rte-disabled="true"></div>
                            </div>
                        </div>
                        <div class="row form-group">
                            <div class="col-12">
                                <label for="grid-internal-name-input" class="form-text text-muted" style="font-size: 17px">Internal Name
                                </label>
                                <small id="grid-internal-name-hint" class="form-text text-muted"><i class="fa fa-exclamation-circle" aria-hidden="true"></i> <em>Does not display on the exhibit; for internal use only.</em></small>
                                <input disabled type="text" id="grid-internal-name-input" name="grid_internal_name"
                                       class="form-control" aria-describedby="grid-internal-name-hint">
                            </div>
                        </div>
                    </div>
                    <div class="col-4 col-md-4">
                        <div class="row form-group">
                            <div class="col-12">
                                <div class="form-text text-muted" style="font-size: 17px">
                                    Grid Columns
                                </div>
                                <input disabled type="number" id="grid-columns" name="grid_columns"
                                       class="form-control" min="1"
                                       style="width: 150px" value="4"><small class="form-text text-muted"></small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="item-submit-card" class="card">
             <div class="card-body">
                 <button class="btn btn-primary" type="button" id="edit-item-btn">
                     <i class="fa fa-edit" aria-hidden="true"></i>&nbsp;&nbsp;Edit
                 </button>&nbsp;&nbsp;<span class="alert alert-warning"><i class="fa fa-warning" aria-hidden="true"></i> Changes made to published exhibit grids are immediately visible to the public</span>
                 <button class="btn btn-primary" type="button" id="save-item-btn" style="visibility: hidden">
                    <i class="fa fa-save" aria-hidden="true"></i>&nbsp;&nbsp;Save
                </button>
            </div>
            <div class="card-footer text-muted"><small>Grid</small></div>
        </div>
    </main>
    <div class="clearfix"></div>
    <%- include('../partials/footer.ejs'); %>
</div>
<!-- libs -->
<%- include('../partials/exhibits-libs-common.ejs'); %>
<!-- app -->
<%- include('../partials/exhibits-app-common.ejs'); %>
<script src="/exhibits-dashboard/static/app/dist/exhibits.module.min.js?<%=build_version%>"></script>
<script src="/exhibits-dashboard/static/app/dist/items.module.min.js?<%=build_version%>"></script>
<script src="/exhibits-dashboard/static/app/dist/items.common.grid.form.module.min.js?<%=build_version%>"></script>
<script src="/exhibits-dashboard/static/app/dist/items.details.grid.module.min.js?<%=build_version%>"></script>
<script>
    navModule.wire_nav_links();
    itemsCommonStandardGridFormModule.init();
    itemsDetailsGridFormModule.init();
    document.querySelector('#edit-item-btn').addEventListener('click', (event) => {
        event.preventDefault();
        document.querySelector('.content').style.visibility = 'hidden';
        const exhibit_id = helperModule.get_parameter_by_name('exhibit_id');
        const item_id = helperModule.get_parameter_by_name('item_id');
        window.location.replace(`/exhibits-dashboard/items/grid/edit?exhibit_id=${exhibit_id}&item_id=${item_id}`);
        return false;
    });
</script>
</body>
</html>
