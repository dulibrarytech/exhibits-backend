<% const _is_details = typeof is_details !== 'undefined' && is_details; %>
<div id="grid-data-card" class="card">
    <div class="card-header">
        <strong class="card-title mb-3">Item Data</strong>
        <div class="btn-group float-right">
            <span id="created" style="text-align: right; font-size: x-small"></span>
        </div>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-8 col-md-8">
                <div class="row form-group">
                    <div class="col-12">
                        <div class="form-text text-muted" style="font-size: 17px"><span id="grid-text-input-label">Text</span>

                        </div>
                        <div id="grid-text-input" aria-labelledby="grid-text-input-label" class="rte-container" data-rte="full"<%- _is_details ? ' data-rte-disabled="true"' : '' %>></div>
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col-12">
                        <label for="grid-internal-name-input" class="form-text text-muted" style="font-size: 17px">Internal Name <span class="badge badge-required">Required</span>
                        </label>
                        <small id="grid-internal-name-hint" class="form-text text-muted"><i class="fa fa-exclamation-circle" aria-hidden="true"></i> <em>Does not display on the exhibit; for internal use only.</em></small>
                        <input <%= _is_details ? 'disabled ' : '' %>type="text" id="grid-internal-name-input" name="grid_internal_name" class="form-control"
                               required maxlength="255" aria-describedby="grid-internal-name-hint">
                    </div>
                </div>
            </div>
            <div class="col-4 col-md-4">
                <div class="row form-group">
                    <div class="col-12">
                        <label for="grid-columns" class="form-text text-muted" style="font-size: 17px">Grid Columns <span class="badge badge-required">Required</span>
                        </label>
                        <% if (_is_details) { %>
                        <input disabled type="number" id="grid-columns" name="grid_columns"
                               class="form-control" min="1"
                               style="width: 150px" value="4" aria-describedby="grid-columns-hint">
                        <small id="grid-columns-hint" class="form-text text-muted"></small>
                        <% } else { %>
                        <select id="grid-columns" name="grid_columns"
                                class="form-control" required
                                aria-describedby="grid-columns-hint">
                            <option value="2">2</option>
                            <option value="3">3</option>
                            <option value="4" selected>4</option>
                        </select>
                        <small id="grid-columns-hint" class="form-text text-muted">Select the number of columns to display (2&ndash;4).</small>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
