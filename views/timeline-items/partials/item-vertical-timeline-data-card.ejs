<% const _is_details = typeof is_details !== 'undefined' && is_details; %>
<div id="grid-data-card" class="card">
    <div class="card-header">
        <strong class="card-title mb-3">Item Data</strong>
        <div class="btn-group float-right">
            <span id="created" style="text-align: right; font-size: x-small"></span>
        </div>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-12 col-md-12">
                <div class="row form-group">
                    <div class="col-12">
                        <div class="form-text text-muted" style="font-size: 17px"><span id="timeline-text-input-label">Text</span>

                        </div>
                        <div id="timeline-text-input" aria-labelledby="timeline-text-input-label" class="rte-container" data-rte="full"<%- _is_details ? ' data-rte-disabled="true"' : '' %>></div>
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col-12">
                        <label for="timeline-internal-name-input" class="form-text text-muted" style="font-size: 17px">Internal Name <span class="badge badge-required">Required</span>
                        </label>
                        <small id="timeline-internal-name-hint" class="form-text text-muted"><i class="fa fa-exclamation-circle" aria-hidden="true"></i> <em>Does not display on the exhibit; for internal use only.</em></small>
                        <input <%= _is_details ? 'disabled ' : '' %>type="text" id="timeline-internal-name-input" name="timeline_internal_name" class="form-control"
                               required maxlength="255" aria-describedby="timeline-internal-name-hint">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
