<div id="<%= input_id %>-group" class="form-group mt-3" style="display: none;">
    <label for="<%= input_id %>" class="form-text text-muted" style="font-size: 15px;">
        <i class="fa fa-file-text-o" aria-hidden="true"></i>&nbsp;Media Name
    </label>
    <input type="text"
           id="<%= input_id %>"
           class="form-control"
           readonly
           style="background-color: #e9ecef; cursor: default;">
    <div id="<%= input_id %>-deleted"
         class="alert alert-warning mt-2 mb-0 py-2"
         role="alert"
         style="display: none;">
        <i class="fa fa-warning" aria-hidden="true"></i>
        This media was deleted from the Media Library, so it will not display on the exhibit.
        Select different media.
    </div>
</div>
