<div id="item-layout-card" class="card">
    <div class="card-header">
        <strong class="card-title mb-3">Item Layout</strong>
    </div>
    <div class="card-body">
        <%# fieldset/legend groups the five layout radios so a screen reader
            announces what is being chosen (WCAG 1.3.1). Bootstrap's reboot
            zeroes the fieldset border/padding/margin, and the legend is
            visually hidden because the card header already shows the name,
            so the rendering is unchanged. -%>
        <fieldset>
            <legend class="visually-hidden">Item Layout</legend>
        <div class="row">
            <div class="col-4 col-md-4">
                <p><img src="/exhibits-dashboard/static/images/item_layout_text_left_media_right.png" width="145" height="135" alt=""></p>
                <p>
                    <label class="btn btn-default" for="item-layout-media-right" style="font-size: 15px">Text media pair, media on the right
                        <input type="radio"
                               name="layout"
                               id="item-layout-media-right"
                               value="media_right"/>
                    </label>
                </p>
            </div>
            <div class="col-4 col-md-4">
                <p><img src="/exhibits-dashboard/static/images/item_layout_media_top_text_bottom.png" width="145" height="135" alt=""></p>
                <p>
                    <label class="btn btn-default" for="item-layout-media-top" style="font-size: 15px">Text media pair,
                        text below media
                        <input type="radio"
                               name="layout"
                               id="item-layout-media-top"
                               value="media_top" checked/>
                    </label>
                </p>
            </div>
            <div class="col-4 col-md-4">
                <p><img src="/exhibits-dashboard/static/images/item_layout_text_top_media_bottom.png" width="145" height="135" alt=""></p>
                <p>
                    <label class="btn btn-default" for="item-layout-media-bottom" style="font-size: 15px">Text media
                        pair, text above the media
                        <input type="radio"
                               name="layout"
                               id="item-layout-media-bottom"
                               value="media_bottom"/>
                    </label>
                </p>
            </div>
        </div>
        <div class="row">
            <div class="col-4 col-md-4">
                <p><img src="/exhibits-dashboard/static/images/item_layout_media_only.png" width="145" height="135" alt=""></p>
                <p>
                    <label class="btn btn-default" for="item-layout-media-only" style="font-size: 15px">Media only, no text
                        <input type="radio"
                               name="layout"
                               id="item-layout-media-only"
                               value="media_only"/>
                    </label>
                </p>
            </div>
            <div class="col-4 col-md-4">
                <p><img src="/exhibits-dashboard/static/images/item_layout_media_left_text_right.png" width="145" height="135" alt=""></p>
                <p>
                    <label class="btn btn-default" for="item-layout-media-left" style="font-size: 15px">Text media pair, media on the left
                        <input type="radio"
                               name="layout"
                               id="item-layout-media-left"
                               value="media_left"/>
                    </label>
                </p>
            </div>
        </div>
        </fieldset>
    </div>
</div>