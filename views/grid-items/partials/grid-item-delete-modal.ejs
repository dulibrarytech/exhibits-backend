<div class="modal fade" id="grid-item-delete-modal" tabindex="-1" role="dialog"
     aria-labelledby="grid-item-delete-modal-title" aria-hidden="true"
     data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger py-2" style="display: flex; align-items: center; justify-content: space-between;">
                <h2 class="modal-title h5 mb-0" id="grid-item-delete-modal-title" style="color: #fff;">
                    <i class="fa fa-exclamation-triangle" style="margin-right: 8px;" aria-hidden="true"></i>
                    Confirm Delete
                </h2>
                <button type="button" class="close ml-auto" data-dismiss="modal" aria-label="Close"
                        id="grid-item-delete-close-btn" style="color: #fff; opacity: 1; margin: 0; padding: 0;">
                    <span aria-hidden="true" style="font-size: 1.5rem;">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div id="grid-item-delete-message"></div>
                <p class="mb-3">Are you sure you want to delete this grid item?</p>
                <p class="mb-0"><strong id="grid-item-delete-name"></strong></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" id="grid-item-delete-confirm-btn">
                    <i class="fa fa-trash" aria-hidden="true"></i>&nbsp;&nbsp;Delete
                </button>
                <button type="button" class="btn btn-outline-secondary" data-dismiss="modal" id="grid-item-delete-cancel-btn">
                    <i class="fa fa-times" aria-hidden="true"></i>&nbsp;&nbsp;Cancel
                </button>
            </div>
        </div>
    </div>
</div>
