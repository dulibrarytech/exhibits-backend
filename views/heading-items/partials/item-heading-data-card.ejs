<div id="item-heading-card" class="card">
    <div class="card-header">
        <strong class="card-title mb-3">Heading Data</strong>
        <div class="btn-group float-right">
            <span id="created" style="text-align: right; font-size: x-small"></span>
        </div>
    </div>
    <form id="item-heading-form" class="form-horizontal">
        <div class="card-body">
            <input id="exhibit-uuid" type="hidden" name="exhibit_uuid">
            <div class="row">
                <div class="col-7 col-md-7">
                    <div class="row form-group">
                        <div class="col-7 col-md-7">
                            <label for="item-heading-type-input" class="form-text text-muted" style="font-size: 17px">
                                Heading Type <span class="badge badge-required">Required</span>
                            </label>
                            <span id="item-heading-type-error" class="is-error"></span>
                            <div class="input-group">
                                <select <%= (typeof is_details !== 'undefined' && is_details) ? 'disabled' : '' %> name="item_heading_type_input" id="item-heading-type-input"
                                        class="form-control-lg form-control text-muted" style="height: 40px">
                                    <option value="">Select From Menu</option>
                                    <option value="">----------</option>
                                    <option value="heading">Heading</option>
                                    <option value="subheading">Subheading</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12 col-md-12">
                    <div class="row form-group">
                        <div class="col-12">
                            <div class="form-text text-muted" style="font-size: 17px">
                                <span id="item-heading-text-input-label">Heading Text <span class="badge badge-required">Required</span></span>
                            </div>
                            <span id="item-heading-text-error" class="is-error"></span>
                            <%
                            /*
                             * Heading Text is authored as plain text — no editor.
                             * The server gate stays at the `reduced` profile, so the
                             * b/i/u and <br> already present in ~170 headings survive
                             * and keep rendering on the public site; staff simply see
                             * that markup literally in the textarea.
                             *
                             * The details view renders the stored markup (not literal
                             * tags) via rteModule.render_static(), which sanitizes and
                             * sets innerHTML. role="group" lets the div carry
                             * aria-labelledby.
                             */
                            %>
                            <% if (typeof is_details !== 'undefined' && is_details) { %>
                            <div id="item-heading-text-input" aria-labelledby="item-heading-text-input-label" role="group" class="rte-readonly"></div>
                            <% } else { %>
                            <textarea id="item-heading-text-input"
                                      aria-labelledby="item-heading-text-input-label"
                                      class="form-control"
                                      rows="2"></textarea>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
