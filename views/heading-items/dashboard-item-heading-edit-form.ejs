<%- include('../partials/header.ejs'); %>
<body>
<%- include('../partials/skip-link.ejs'); %>
<%- include('../partials/nav-dashboard'); %>
<div id="right-panel" class="right-panel">
    <%- include('../partials/main-header.ejs'); %>
    <main id="main" class="content" tabindex="-1">
        <div id="message"></div>
        <h1><span id="exhibit-title"></span> - Heading</h1>
        <%- include('partials/item-heading-data-card.ejs'); %>
        <%- include('../partials/item-styles-card.ejs'); %>
        <input type="hidden" id="is-published" name="is_published">
        <div id="item-submit-card" class="card">
            <div class="card-body">
                <button class="btn btn-primary" type="button" id="save-heading-btn">
                    <i class="fa fa-save" aria-hidden="true"></i>&nbsp;&nbsp;Save
                </button>
                <button class="btn btn-outline-secondary ms-2" type="button" id="cancel-exhibit-btn">
                    <i class="fa fa-times" aria-hidden="true"></i>&nbsp;&nbsp;Cancel
                </button>
            </div>
            <div class="card-footer text-muted"><small>Heading</small></div>
        </div>
    </main>
    <div class="clearfix"></div>
    <%- include('../partials/footer.ejs'); %>
</div>
<!-- libs -->
<%- include('../partials/exhibits-libs-common.ejs'); %>
<!-- app -->
<%- include('../partials/exhibits-app-common.ejs'); %>
<script src="/exhibits-dashboard/static/app/dist/exhibits.module.min.js?<%=build_version%>"></script>
<script src="/exhibits-dashboard/static/app/dist/items.module.min.js?<%=build_version%>"></script>
<script src="/exhibits-dashboard/static/app/dist/items.common.heading.form.module.min.js?<%=build_version%>"></script>
<script src="/exhibits-dashboard/static/app/dist/items.edit.heading.form.module.min.js?<%=build_version%>"></script>
<script>
    navModule.wire_nav_links();
    itemsEditHeadingFormModule.init();
    itemsCommonHeadingFormModule.init();

    pageActionsModule.wire_cancel_button({
        redirect_path: '/items',
        params: ['exhibit_id'],
        confirm_message: 'Discard unsaved changes and return to the exhibit item list?'
    });

</script>
</body>
</html>
