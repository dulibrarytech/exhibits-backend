<% const _is_details = typeof is_details !== 'undefined' && is_details; %>
<div id="item-data-card" class="card">
    <div class="card-header">
        <strong class="card-title mb-3">Item Data</strong>
        <div class="btn-group float-right">
            <span id="created" style="text-align: right; font-size: x-small"></span>
        </div>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-12 col-md-12">
                <div class="row form-group">
                    <div class="col-12">
                        <div class="form-text text-muted" style="font-size: 17px">
                            <span id="item-title-input-label">Title <small><em>(Optional)</em></small></span>
                            
                        </div>
                        <span id="item-title-error" class="is-error"></span>
                        <% if (_is_details) { %>
                        <div id="item-title-input" aria-labelledby="item-title-input-label" class="rte-readonly"></div>
                        <% } else { %>
                        <div id="item-title-input" aria-labelledby="item-title-input-label" class="rte-container rte-single-line" data-rte="reduced"></div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-12 col-md-12">
                <div class="row form-group">
                    <div class="col-12">
                        <label for="item-date-input" class="form-text text-muted" style="font-size: 17px">Date <span class="badge badge-required">Required</span></label>
                        <input class="form-control" id="item-date-input" type="date" />
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-12 col-md-12">
                <div class="row form-group">
                    <div class="col-12">
                        <div class="form-text text-muted" style="font-size: 17px"><span id="item-text-input-label">Exhibit Text <span class="badge badge-required">Required</span></span>
                            
                        </div>
                        <% if (_is_details) { %>
                        <div id="item-text-input" aria-labelledby="item-text-input-label" class="rte-readonly"></div>
                        <% } else { %>
                        <div id="item-text-input" aria-labelledby="item-text-input-label" class="rte-container" data-rte="full"></div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
        <div class="row" id="is-media-only-description" style="display: none">
            <div class="col-12 col-md-12">
                <div class="row form-group">
                    <div class="col-12">
                        <div class="form-text text-muted" style="font-size: 17px"><span id="item-description-input-label">Pop-up Window Description</span>
                        </div>
                        <% if (_is_details) { %>
                        <div id="item-description-input" aria-labelledby="item-description-input-label" class="rte-readonly"></div>
                        <% } else { %>
                        <div id="item-description-input" aria-labelledby="item-description-input-label" class="rte-container" data-rte="full"></div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
